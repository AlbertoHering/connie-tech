---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = 'Terms of Service — Connietech';
const description = 'The terms that govern your use of Connietech services and website.';
---
<Base lang="en" title={title} description={description} url="https://connietech.com/terms">
  <Header lang="en" />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose prose-brand">
    <h1>Terms of Service</h1>
    <p>Last updated: 2025-01-01</p>

    <h2>Agreement</h2>
    <p>By using our website or engaging our sourcing services, you agree to these Terms.</p>

    <h2>Services</h2>
    <p>Connietech provides sourcing, vendor coordination, optional design guidance, and logistics support for infrastructure projects.</p>

    <h2>Quotes and pricing</h2>
    <p>Quotes are estimates based on current supplier pricing and availability and may change until purchase is confirmed.</p>

    <h2>Client responsibilities</h2>
    <p>You are responsible for the accuracy of project specifications and for complying with applicable laws and site requirements.</p>

    <h2>Payments and terms</h2>
    <p>Payment terms are specified in each proposal or invoice. Late payments may incur fees or pauses in service.</p>

    <h2>Warranties and liability</h2>
    <p>Products are subject to manufacturer warranties. To the maximum extent permitted by law, Connietech disclaims all other warranties and is not liable for indirect or consequential damages.</p>

    <h2>Confidentiality</h2>
    <p>We keep your project details confidential and share them only with suppliers/logistics partners as needed to fulfill your request.</p>

    <h2>Governing law</h2>
    <p>These Terms are governed by the laws of Florida, USA, without regard to conflicts of law provisions.</p>

    <h2>Changes</h2>
    <p>We may update these Terms. We will post the new version with an updated date.</p>

    <h2>Contact</h2>
    <p>Email: <a href="mailto:connie@connietech.com">connie@connietech.com</a></p>
  </main>
  <Footer lang="en" />
</Base>
