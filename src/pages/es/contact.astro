-/--
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
const title = 'Contacto — Connietech';
const description = 'Cuéntanos tu proyecto. Respondemos en 24 horas.';
const phone = '+1-786-334-8592';
const email = 'constanza.andrade@connie-tech.com';
const defaultMsg = 'Hola Connietech, quisiera hablar sobre un proyecto.';
const wa = `https://wa.me/17863348592?text=${encodeURIComponent(defaultMsg)}`;
const endpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT || '';
---
<Base lang="es" title={title} description={description} url="https://connietech.com/es/contact">
  <Header lang="es" />
  <main>
    <section id="call" class="brand-gradient text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <h1 class="text-3xl sm:text-4xl font-black">Hablemos</h1>
        <p class="mt-2 text-white/90">Revisamos y respondemos en 24 horas.</p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
          <a href={`tel:${phone.replace(/[^\d+\-() ]/g,'')}`} class="underline">{phone}</a>
          <span class="hidden sm:inline">•</span>
          <a href={`mailto:${email}`} class="underline">{email}</a>
          <span class="hidden sm:inline">•</span>
          <a href={wa} target="_blank" class="underline">WhatsApp</a>
        </div>
      </div>
    </section>

    <section id="project" class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-xl ring-1 ring-gray-200 p-6 sm:p-8">
          <h2 class="text-2xl font-black">Describe tu proyecto</h2>
          <p class="text-sm text-gray-600 mt-1">Cuéntanos sobre tu proyecto</p>

          <form id="leadForm" class="mt-6" aria-describedby="postSubmit" data-endpoint={endpoint}>
            <div class="grid sm:grid-cols-2 gap-4">
              <div><label for="name" class="block text-sm font-medium">Nombre</label><input id="name" name="name" type="text" required class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue" /></div>
              <div><label for="company" class="block text-sm font-medium">Empresa</label><input id="company" name="company" type="text" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue" /></div>
              <div><label for="email" class="block text-sm font-medium">Email</label><input id="email" name="email" type="email" required class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue" /></div>
              <div><label for="phone" class="block text-sm font-medium">Teléfono</label><input id="phone" name="phone" type="tel" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue" /></div>
              <div><label for="type" class="block text-sm font-medium">Tipo de proyecto</label><select id="type" name="type" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"><option>Data Center</option><option>Cableado</option><option>Energía</option><option>CCTV</option><option>Redes</option><option>Mixto</option></select></div>
              <div><label for="budget" class="block text-sm font-medium">Alcance/Presupuesto</label><select id="budget" name="budget" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"><option>&lt;$10K</option><option>$10–50K</option><option>$50–100K</option><option>$100K+</option></select></div>
              <div><label for="timeline" class="block text-sm font-medium">Plazo</label><select id="timeline" name="timeline" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"><option>Urgente (1 semana)</option><option>1–2 semanas</option><option>1 mes</option><option>En planificación</option></select></div>
              <div><label for="location" class="block text-sm font-medium">Ubicación</label><select id="location" name="location" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"><option>Sur de Florida</option><option>Caribe</option><option>Centroamérica</option><option>Latinoamérica</option><option>Otra</option></select></div>
              <div class="sm:col-span-2"><label for="description" class="block text-sm font-medium">Descripción del proyecto</label><textarea id="description" name="description" rows="4" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"></textarea></div>
              <div class="sm:col-span-2"><label for="questions" class="block text-sm font-medium">¿Dudas de diseño? (opcional)</label><textarea id="questions" name="questions" rows="3" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"></textarea></div>
              <div><label for="ref" class="block text-sm font-medium">¿Cómo nos conociste?</label><select id="ref" name="ref" class="mt-1 w-full rounded-md border border-gray-300 focus:border-brand-blue focus:ring-brand-blue"><option>Referencia</option><option>Google</option><option>LinkedIn</option><option>Relación previa</option><option>Otro</option></select></div>
            </div>
            <div class="mt-6 flex items-center justify-end">
              <button type="submit" class="rounded-md bg-brand-green px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-600">Enviar</button>
            </div>
            <p id="postSubmit" class="sr-only">¡Gracias! Revisaremos tu proyecto y te contactaremos en 24 horas.</p>
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
          </form>
          <p id="thanks" class="hidden mt-6 rounded-md bg-green-50 p-4 text-green-800">¡Gracias! Revisaremos tu proyecto y te contactaremos en 24 horas.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="es" />
  <WhatsAppButton lang="es" />
</Base>

<script is:inline>
  const form = document.getElementById('leadForm');
  const thanks = document.getElementById('thanks');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    // Honeypot
    if ((fd.get('website') || '').toString().trim() !== '') { return; }
    const endpoint = form.getAttribute('data-endpoint') || '';

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn?.textContent;
    submitBtn?.setAttribute('disabled', 'true');
    submitBtn?.classList.add('opacity-60', 'cursor-not-allowed');
    submitBtn && (submitBtn.textContent = 'Enviando...');

    try {
      if (endpoint && endpoint.includes('/exec')) {
        // Codificar como application/x-www-form-urlencoded (Apps Script lee desde e.parameter)
        const params = new URLSearchParams();
        fd.forEach((v, k) => params.append(k, String(v)));
        await fetch(endpoint, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
          body: params.toString()
        });
      } else {
        console.warn('Endpoint inválido o ausente. Usando mailto como alternativa.');
        const subject = encodeURIComponent('Nuevo lead de proyecto');
        const body = encodeURIComponent(Array.from(fd.entries()).map(([k, v]) => `${k}: ${v}`).join('\n'));
        window.location.href = `mailto:constanza.andrade@connie-tech.com?subject=${subject}&body=${body}`;
      }
    } catch (err) {
      console.error(err);
    } finally {
      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-60', 'cursor-not-allowed');
      submitBtn && originalText && (submitBtn.textContent = originalText);
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
    }
  });
</script>
