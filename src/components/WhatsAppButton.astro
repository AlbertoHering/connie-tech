---
const phone = '+17863348592';
const msg = Astro.props.lang === 'es' ? 'Hola Connietech, quisiera hablar sobre un proyecto.' : 'Hi Connietech, I’d like to discuss a project.';
const href = `https://wa.me/${phone.replace(/[^\d]/g,'')}?text=${encodeURIComponent(msg)}`;
---
<a href={href} target="_blank" rel="noopener" aria-label="WhatsApp"
  class="fixed right-4 bottom-4 z-40 inline-flex h-12 w-12 items-center justify-center rounded-full bg-green-500 shadow-lg hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-500">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="h-6 w-6"><path d="M.057 24l1.687-6.163A11.867 11.867 0 0111.898 0c6.59 0 11.945 5.354 11.945 11.943 0 6.59-5.354 11.944-11.945 11.944A11.9 11.9 0 014.9 22.257L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.591 4.632 0 8.41-3.774 8.41-8.414 0-4.632-3.778-8.413-8.41-8.413-4.637 0-8.415 3.781-8.415 8.413 0 2.036.66 3.924 1.773 5.4l-.938 3.42 3.188-.997zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.03-.967-.272-.099-.47-.149-.669.149-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.074-.149-.669-1.611-.916-2.205-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.872.118.571-.085 1.758-.718 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
